{
  "name": "all-ui-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright test-automation suite for the ALL app",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test --project=chromium --project=phone-android --project=phone-ios --project=tablet-ios --project=laptop-chromium --project=laptop-firefox --project=laptop-webkit --project=desktop-chromium --workers=2",
    "test:headed": "playwright test --headed",
    "regression": "node scripts/run-e2e.js --regression",
    "e2e": "node scripts/run-e2e.js",
    "e2e:uat": "node scripts/run-e2e.js --env UAT",
    "e2e:lab": "node scripts/run-e2e.js --env LAB",
    "e2e:lab2": "node scripts/run-e2e.js --env LAB2",
    "e2e:hindi": "node scripts/run-e2e.js --lang hi",
    "e2e:full": "node scripts/run-full-e2e-parallel.js",
    "lang:check": "tsx scripts/check-language-readiness.js",
    "rules": "node scripts/rule-engine.js",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "responsive": "playwright test --project=phone-android --project=phone-ios --project=tablet-ios --project=laptop-chromium --project=laptop-firefox --project=laptop-webkit --project=desktop-chromium",
    "responsive:no-webkit-deps": "WEBKIT_FALLBACK=chromium npm run responsive",
    "foundation": "playwright test --project=chromium src/tests/discovery/foundation-f --workers=1",
    "mastery": "playwright test --project=chromium src/tests/discovery/mastery-m[4-9].spec.ts --workers=1",
    "mastery:responsive": "npm run responsive -- src/tests/responsive/mastery.responsive.spec.ts",
    "mastery:full": "playwright test --project=chromium --project=phone-android --project=phone-ios --project=tablet-ios --project=laptop-chromium --project=laptop-firefox --project=laptop-webkit --project=desktop-chromium src/tests/discovery/mastery-m[4-9].spec.ts src/tests/responsive/mastery.responsive.spec.ts --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
