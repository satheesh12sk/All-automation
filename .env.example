# Run axis — see config/environments.ts and config/language.ts
# BASE_URL overrides ENV/TEST_ENV when set.
ENV=axl-test
# TEST_ENV=axl-test
# BASE_URL=
TEST_LANG=en
# APP_LANG=en

GRADE=

# VQA grading — see src/services/visionService.ts
VISION_PROVIDER=claude
VISION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Unused — guest accounts are minted by DiscoveryHelper
TEST_USERNAME=
TEST_PASSWORD=
